# AI 변환 서버용 (server/index.mjs, api/convert.ts) — 절대 커밋하지 말 것
ANTHROPIC_API_KEY=sk-ant-...

# 프런트엔드: 변환 엔드포인트 주소 (미설정 시 http://localhost:8787/api/convert)
# Firebase Functions 사용 시: https://<region>-<project>.cloudfunctions.net/convert
# VITE_CONVERT_ENDPOINT=https://your-app.vercel.app/api/convert

# ── Firebase (선택) ───────────────────────────────────────────────
# 아래 값이 채워지면 진행도·오답노트·랭킹이 자동으로 Firestore 동기화됩니다.
# 비워두면 localStorage 로 동작합니다. (Firebase 콘솔 > 프로젝트 설정 > 웹 앱)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project
# VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
